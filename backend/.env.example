# Configuración del backend (alternativa a local.settings.json; usa uno de los dos).
# Copia este archivo como backend/.env y llena los valores que te entregue el equipo de EY.

# --- Azure OpenAI (obligatorio): resumen, guion de audio y lectura de imágenes ---
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<clave>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Azure AI Speech (obligatorio para el audio) ---
AZURE_SPEECH_KEY=<clave>
# Usa la región...
AZURE_SPEECH_REGION=eastus2
# ...o, si te dan un endpoint propio (dominio personalizado / private endpoint), ponlo aquí:
AZURE_SPEECH_ENDPOINT=

# --- Azure AI Document Intelligence (opcional: OCR de PDFs escaneados) ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# --- Almacenamiento ---
# local = carpeta .data/ en disco (no necesita Azure) | blob = Azure Blob Storage | auto
STORAGE_MODE=local
LOCAL_STORAGE_DIR=
STORAGE_CONNECTION_STRING=
