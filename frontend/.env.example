# Cómo habla el frontend con el backend:
#   inprocess -> ejecuta el código de backend/ dentro de Streamlit (solo Python; sin Functions)
#   http      -> llama a la API de Azure Functions en BACKEND_URL
BACKEND_MODE=inprocess
# Solo para BACKEND_MODE=http:
BACKEND_URL=http://localhost:7071/api
FUNCTION_KEY=
# Login: local (usuarios de APP_USERS) | easyauth (App Service + Entra ID) | off
AUTH_MODE=local
# usuario:hash separados por ';'. Genera cada uno con: python auth.py nombre.apellido
APP_USERS=
